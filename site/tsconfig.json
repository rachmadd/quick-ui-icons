{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": ["../node_modules/@types"],
    "paths": {
      "@quick-ui/icons": ["../packages/react/src/index.ts"],
      "@quick-ui/icons/sharp": ["../packages/react/src/sharp/index.ts"]
    }
  },
  "include": ["src"]
}
