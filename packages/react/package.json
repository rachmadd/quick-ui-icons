{
  "name": "@quick-ui/icons",
  "version": "3.0.0",
  "description": "Quick UI's icon set as React components on a 24px grid: outline, fill and duotone, rounded or sharp.",
  "license": "MIT",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "author": "Quick UI",
  "homepage": "https://quick-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rachmadd/quick-ui-icons.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/rachmadd/quick-ui-icons/issues",
  "keywords": [
    "quick-ui",
    "icons",
    "react",
    "svg",
    "shadcn",
    "icon-set",
    "tailwind"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sharp": {
      "types": "./dist/sharp/index.d.ts",
      "default": "./dist/sharp/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./sharp/icons/*": {
      "types": "./dist/sharp/icons/*.d.ts",
      "default": "./dist/sharp/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "scripts": {
    "build": "node ../../scripts/generate.mjs && node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/generate.mjs && node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json"
  }
}
