{
  "name": "@quick-ui/icons",
  "version": "3.0.0",
  "description": "Quick UI's icon set as React components, on a 24px grid.",
  "license": "MIT",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "author": "Quick UI",
  "homepage": "https://quick-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rachmadd/quick-ui-icons.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/rachmadd/quick-ui-icons/issues",
  "keywords": [
    "quick-ui",
    "icons",
    "react",
    "svg",
    "shadcn",
    "icon-set",
    "tailwind"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./two-tone": {
      "types": "./dist/two-tone.d.ts",
      "default": "./dist/two-tone.js"
    },
    "./duotone": {
      "types": "./dist/duotone.d.ts",
      "default": "./dist/duotone.js"
    },
    "./fill": {
      "types": "./dist/fill.d.ts",
      "default": "./dist/fill.js"
    },
    "./sharp": {
      "types": "./dist/sharp.d.ts",
      "default": "./dist/sharp.js"
    },
    "./sharp/two-tone": {
      "types": "./dist/sharp-two-tone.d.ts",
      "default": "./dist/sharp-two-tone.js"
    },
    "./sharp/duotone": {
      "types": "./dist/sharp-duotone.d.ts",
      "default": "./dist/sharp-duotone.js"
    },
    "./sharp/fill": {
      "types": "./dist/sharp-fill.d.ts",
      "default": "./dist/sharp-fill.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json"
  }
}
