{
  "name": "quick-ui-icons",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Quick UI's icon set: 24px icons in outline, fill and duotone, rounded and sharp, and the pipeline that builds them into @quick-ui/icons.",
  "keywords": [
    "quick-ui",
    "icons",
    "svg",
    "icon-set"
  ],
  "author": "Quick UI",
  "homepage": "https://quick-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rachmadd/quick-ui-icons.git"
  },
  "bugs": "https://github.com/rachmadd/quick-ui-icons/issues",
  "scripts": {
    "build": "node scripts/generate.mjs && node scripts/clean-dist.mjs && tsc -p packages/react",
    "typecheck": "node scripts/generate.mjs && tsc -p packages/react --noEmit --declaration false",
    "icons:build": "node pipeline/build.mjs",
    "icons:check": "node pipeline/build.mjs --check",
    "icons:lint": "node pipeline/lint.mjs",
    "icons:react": "node scripts/generate.mjs",
    "icons:figma": "node pipeline/check-figma.mjs",
    "readmes:check": "node pipeline/check-readmes.mjs",
    "readmes:fix": "node pipeline/check-readmes.mjs --fix",
    "icons:ci": "node pipeline/build.mjs --check && node scripts/generate.mjs && node pipeline/check-readmes.mjs && node pipeline/parallel.mjs \"tsc -p packages/react --noEmit --declaration false\" \"node pipeline/lint.mjs\"",
    "test": "pnpm build && node --test \"packages/react/test/*.test.mjs\"",
    "size:budget": "pnpm build && node scripts/size-budget.mjs",
    "built-in": "node scripts/generate-built-in.mjs"
  },
  "devDependencies": {
    "@types/react": "^19",
    "esbuild": "0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5"
  }
}
