{
  "name": "quick-ui-icons",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Quick UI's icon set: 24px icons in eight styles, and the pipeline that builds them into @quick-ui/icons.",
  "keywords": [
    "quick-ui",
    "icons",
    "svg",
    "icon-set"
  ],
  "author": "Quick UI",
  "homepage": "https://quick-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rachmadd/quick-ui-icons.git"
  },
  "bugs": "https://github.com/rachmadd/quick-ui-icons/issues",
  "scripts": {
    "build": "tsc -p packages/react",
    "typecheck": "tsc -p packages/react --noEmit --declaration false",
    "icons:build": "node pipeline/build.mjs",
    "icons:check": "node pipeline/build.mjs --check",
    "icons:lint": "node pipeline/lint.mjs",
    "icons:react": "node pipeline/build-react.mjs",
    "icons:react:check": "node pipeline/build-react.mjs --check",
    "icons:figma": "node pipeline/check-figma.mjs",
    "keywords:emit": "node pipeline/build-keywords.mjs --emit",
    "keywords:build": "node pipeline/build-keywords.mjs",
    "keywords:check": "node pipeline/build-keywords.mjs --check",
    "readmes:check": "node pipeline/check-readmes.mjs",
    "readmes:fix": "node pipeline/check-readmes.mjs --fix",
    "icons:ci": "node pipeline/build.mjs --check && node pipeline/build-react.mjs --check && node pipeline/check-readmes.mjs && node pipeline/parallel.mjs \"tsc -p packages/react --noEmit --declaration false\" \"node pipeline/lint.mjs\""
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuzzysort": "^3.1.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
